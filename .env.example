# HydraDB node — see README for how to start one (Docker or source build).
# Defaults below match the local dev node, so you only need these to override.
HYDRADB_URL=http://127.0.0.1:8443
HYDRADB_TOKEN=local-development-token-32-bytes
HYDRADB_GRAPH=default
HYDRADB_CELL=cell-0
HYDRADB_NAMESPACE=default

# Uncomment to force offline mode (explorer still works on live registry data):
# HYDRADB_DISABLED=1
